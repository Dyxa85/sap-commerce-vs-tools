{
  "name": "sap-commerce-vs-tools-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=!sap-commerce-vs-tools-monorepo build",
    "typecheck": "pnpm -r --no-bail --reporter=append-only --filter=!sap-commerce-vs-tools-monorepo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mock-hac": "pnpm --filter @sapcommerce-vstools/mock-hac start",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:host": "pnpm --filter sap-commerce-vs-tools run test:host"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "type": "module"
}
